diff --git a/pkg/host/internal/service/ovs_unit_test.go b/pkg/host/internal/service/ovs_unit_test.go
new file mode 100644
index 000000000..8430a873e
--- /dev/null
+++ b/pkg/host/internal/service/ovs_unit_test.go
@@ -0,0 +1,25 @@
+package service
+
+import (
+	"os"
+	"strings"
+	"testing"
+)
+
+func TestOVSUnitArguments(t *testing.T) {
+	srv, err := New(nil).ReadOvsServiceInjectionManifestFile(
+		"../../../../bindata/manifests/switchdev-config/ovs-units/ovs-vswitchd.service.yaml",
+		map[string]string{"hw-offload": "true", "tc-policy": "none",
+			"test-value": "$NOT_AN_ENV; $(exit 73); `exit 74`; %n \" \\"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Count(srv.Content, "ExecStartPre=:") != 3 {
+		t.Fatal("OVS values must use direct systemd arguments without environment expansion")
+	}
+	if name := os.Getenv("MOCK_OVS_UNIT_OUT"); name != "" {
+		if err := os.WriteFile(name, []byte(srv.Content), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
